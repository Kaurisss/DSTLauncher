# DST Linux 面板 compose 环境变量示例。
# 复制为 .env 后按需修改；全部可留空使用默认值。

# 容器内运行用户的 UID/GID，应与宿主 ./data 目录属主一致，避免权限错误。
# 查询宿主当前用户：id -u / id -g
PANEL_UID=1000
PANEL_GID=1000

# 可选：复用宿主上已安装的 DST 专用服务器目录（含 bin64/ 的那一层）。
# 留空时面板会用 SteamCMD 把服务端安装到 /data/steamapps/common/Don't Starve Together Dedicated Server（约 2GB）。
# 注意：此路径必须是容器内可见的路径；若指向宿主目录，需在 compose 里额外挂载。
DST_SERVER_DIR=
