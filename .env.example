# DST Linux 面板 Compose 环境变量示例。
# 复制为 .env 后修改，DST_PANEL_PASSWORD 必须设置。

# 容器内运行用户的 UID/GID，应与宿主 ./data 目录属主一致，避免权限错误。
# 查询宿主当前用户：id -u / id -g
PANEL_UID=1000
PANEL_GID=1000

# 面板登录用户名和密码。
DST_PANEL_USERNAME=admin
DST_PANEL_PASSWORD=

# 公网部署时填写域名，并使用 `docker compose --profile public up -d --build`。
# 域名的 DNS A/AAAA 记录需要指向这台服务器，防火墙需放行 TCP 80/443。
PANEL_DOMAIN=

# 可选：复用宿主上已安装的 DST 专用服务器目录（含 bin64/ 的那一层）。
# 留空时面板会用 SteamCMD 把服务端安装到 /data/steamapps/common/Don't Starve Together Dedicated Server。
# 此路径必须是容器内可见的路径。
DST_SERVER_DIR=
